# Node runtime config (docker --env-file worker/.env, or export before `npm run start:node`).
# The Cloudflare Worker gets the same names from wrangler.toml [vars] + `wrangler secret put`.
# NEVER put production tokens in a file that could reach git; .env is gitignored.

PORT=5000
HOST=0.0.0.0
# sqlite metrics live here; unset = in-memory counters (lost on restart)
DATA_DIR=./data
# the public HTTPS origin Discord/Telegram will call; /health compares their config against it
PUBLIC_URL=https://bot.example.com
ENVIRONMENT=local

CHIPS_API_HOST=https://api.chips.gg/prod/api
CHIPS_TOKEN=

# dev pair for testing: devbot 1326290512675606548 + @chipsgg_dev_bot. Prod tokens only on prod.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# guild where /linkaccount may assign VIP rank roles; empty = never
DISCORD_ROLES_GUILD_ID=
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
