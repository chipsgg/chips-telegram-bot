{
  "name": "@chipsgg/bot-worker",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Chips.gg community bot on Cloudflare Workers (Discord interactions + Telegram webhook)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts",
    "register:discord": "node scripts/register-discord.js",
    "register:telegram": "node scripts/register-telegram.js",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "wrangler": "^4"
  }
}
